{
  "expo": {
    "name": "SignBridge",
    "slug": "signbridge",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "signbridge",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "react": {
      "strictMode": false
    },
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "Allow SignBridge to access your camera",
        "NSMicrophoneUsageDescription": "Allow SignBridge to access your microphone"
      }
    },
    "android": {
      "package": "com.nmnghi.VOYA_App",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundImage": "./assets/images/adaptive-background.png"
      },
      "edgeToEdgeEnabled": true,
      "softwareKeyboardLayoutMode": "resize",
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "CAMERA",
        "RECORD_AUDIO"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
  "expo-splash-screen",
  {
    "image": "./assets/images/adaptive-icon.png",
    "imageWidth": 120,
    "resizeMode": "contain",
    "backgroundColor": "#0098E8",
    "dark": {
      "image": "./assets/images/adaptive-icon.png",
      "backgroundColor": "#0098E8"
    }
  }
],
      "react-native-vision-camera",
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 26,
            "ndk": {
              "abiFilters": [
                "armeabi-v7a",
                "arm64-v8a",
                "x86",
                "x86_64"
              ]
            }
          }
        }
      ],
      "expo-video",
      "expo-localization"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "b45dc617-157e-465c-a68e-ca929045a65b"
      }
    },
"owner": "ctu-signbridge"  }
}